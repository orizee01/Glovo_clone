{
  "name": "glovo",
  "version": "1.0.0",
  "description": "food api",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "rm -rf dist && tsc",
    "preset": "npm run migrate:up && ts-node script/seedSupperAdmin",
    "prestart": "npm run build && npm run migrate && npm run seed:up",
    "start:prod": "node dist/server.js",
    "start:dev": "nodemon --exec ts-node ./src/server.ts",
    "migrate": "db-migrate up --migrations-dir=src/migrations --config database.json",
    "migrate:create": "db-migrate create --migrations-dir=src/migrations",
    "migrate:up": "db-migrate up --migrations-dir=src/migrations --config database.json",
    "migrate:down": "db-migrate down --migrations-dir=src/migrations --config database.json",
    "migrate:reset": "db-migrate reset --migrations-dir=src/migrations --config database.json",
    "migrate-test:up": "db-migrate up --migrations-dir=src/migrations --config database.json -e test",
    "migrate-test:down": "db-migrate down --migrations-dir=src/migrations --config database.json -e test",
    "migrate-test:reset": "db-migrate reset --migrations-dir=src/migrations --config database.json -e test",
    "seed:create": "db-migrate create seed --migrations-dir=src/migrations/seed",
    "seed:up": "db-migrate up --migrations-dir=src/migrations/seed --config database.json",
    "seed:down": "db-migrate down --migrations-dir=src/migrations/seed --config database.json",
    "seed:reset": "db-migrate reset --migrations-dir=src/migrations/seed --config database.json",
    "seed:up:test": "db-migrate up --migrations-dir=src/migrations/seed --config database.json -e test",
    "seed:reset:test": "db-migrate reset --migrations-dir=src/migrations/seed --config database.json -e test",
    "pretest": "cross-env GLOVO_NODE_ENV=test npm run migrate-test:reset && npm run migrate-test:up && npm run seed:reset:test && npm run seed:up:test",
    "test": "cross-env GLOVO_NODE_ENV=test nyc --reporter=lcov --reporter=text --reporter=text-summary mocha --require ts-node/register --exit --recursive --timeout=150000 tests/index.ts"
  },
  "author": "",
  "license": "ISC",
  "keywords": [],
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bluebird": "^3.5.42",
    "@types/chai": "^5.2.2",
    "@types/chance": "^1.1.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "chai": "^5.2.1",
    "cross-env": "^7.0.3",
    "mocha": "^11.7.1",
    "nyc": "^17.1.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bluebird": "^3.7.2",
    "chance": "^1.1.13",
    "cors": "^2.8.5",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "debug": "^2.6.0",
     "typescript": "^5.8.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "pg-monitor": "^3.0.0",
    "pg-promise": "^11.15.0",
    "winston": "^3.17.0"
  }
}
